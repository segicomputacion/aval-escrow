# ============================================
# AVAL - Configuración de entorno
# ============================================

# Puerto del servidor
PORT=3001

# --- Blockchain (Polygon) ---
# Contracto desplegado por la plataforma en la cadena. Usar AMOY (testnet vigente).
# RPC: probá el endpoint de tu proveedor (Alchemy/QuickNode/Envless); los
#      oficiales https://rpc-amoy.polygon.technology no resolvieron desde este entorno.
# Si querés probar el deploy sin red: npx hardhat run ../scripts/deploy.js --network hardhat
# Nota: se requiere wallet deployer con fondos para crear el contrato en AMOY/MAINNET.
AMOY_RPC=
POLYGON_RPC=https://polygon-rpc.com
NETWORK_NAME=polygon-mainnet
CONTRACT_ADDRESS=0xdE15d1C160D78e0A1CA94707951756aBC7Bcc8B8
USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# Wallet de servicio (PRIVATE KEY de la wallet que despliega y opera el contrato).
# ⚠️ NUNCA compartirla. Rotar periódicamente.
PRIVATE_KEY=tu_private_key_aca
PLATFORM_WALLET_ADDRESS=0x52946000591272841D1118eCCad5912ae97f466a

# --- Datos bancarios para transferencias ARS ---
BANCO_ALIAS=alias.mp
BANCO_CBU=0000000000000000000000
BANCO_TITULAR=Titular de la cuenta
BANCO_CUIT=00-00000000-0
BANCO_NOMBRE=Banco Ejemplo
MONTO_MINIMO=50000

# --- Email (SMTP) ---
# NEEDED in production: the "email code" login doesn't work without it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=tu_contraseña_aplicacion
SMTP_FROM=tu@email.com
# In development (NODE_ENV != production) without SMTP the login endpoint
# returns the code in the response, so you can test locally.

# --- CORS ---
# Por defecto no se habilita (el frontend se sirve desde el mismo origen).
# Si servís el frontend desde otro origen, pon su host o hosts aquí.
# CORS_ORIGIN=http://localhost:3001

# --- Admin ---
# Cuenta admin (created at startup). Set ADMIN_PASSWORD! Without it,
# the admin account is not created.
ADMIN_EMAIL=admin@avalescrow.com
ADMIN_PASSWORD=tu_contraseña_admin_fuerte
